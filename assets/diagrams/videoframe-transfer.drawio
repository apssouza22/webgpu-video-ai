<mxfile>
  <diagram name="videoframe-transfer">
    <mxGraphModel defaultFontFamily="Noto Sans JP" page="0" pageWidth="1600" pageHeight="700">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>

        <!-- Title -->
        <mxCell id="title" value="VideoFrame Zero-Copy Transfer" style="text;html=1;fontSize=28;fontStyle=1;fontFamily=Noto Sans JP;align=center;verticalAlign=middle;strokeColor=none;fillColor=none;" vertex="1" parent="1">
          <mxGeometry x="100" y="15" width="1400" height="45" as="geometry"/>
        </mxCell>
        <!-- Meta -->
        <mxCell id="meta" value="VideoFrame ownership transferred to worker via postMessage transfer list — no pixel data copied" style="text;html=1;fontSize=14;fontFamily=Noto Sans JP;align=center;verticalAlign=middle;strokeColor=none;fillColor=none;fontStyle=2;" vertex="1" parent="1">
          <mxGeometry x="100" y="58" width="1400" height="25" as="geometry"/>
        </mxCell>

        <!-- Arrows (back layer) drawn between x=590 and x=1010 (420px gap) -->
        <!-- MT → Worker (red, transfer) -->
        <mxCell id="arrow_mw" style="edgeStyle=none;rounded=0;html=1;strokeWidth=3;endArrow=block;endFill=1;strokeColor=#b85450;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="590" y="320" as="sourcePoint"/>
            <mxPoint x="1010" y="320" as="targetPoint"/>
          </mxGeometry>
        </mxCell>
        <!-- Arrow label centered in gap -->
        <mxCell id="arrow_mw_label" value="postMessage(frame, [frame]) — zero-copy, no memcpy" style="text;html=1;fontSize=14;fontFamily=Noto Sans JP;align=center;verticalAlign=middle;strokeColor=none;fillColor=none;fontColor=#b85450;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="590" y="290" width="420" height="25" as="geometry"/>
        </mxCell>

        <!-- Worker → MT (green, result) -->
        <mxCell id="arrow_wm" style="edgeStyle=none;rounded=0;html=1;strokeWidth=3;endArrow=block;endFill=1;strokeColor=#82b366;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1010" y="570" as="sourcePoint"/>
            <mxPoint x="590" y="570" as="targetPoint"/>
          </mxGeometry>
        </mxCell>
        <!-- Arrow label -->
        <mxCell id="arrow_wm_label" value="detect-result — bounding boxes" style="text;html=1;fontSize=14;fontFamily=Noto Sans JP;align=center;verticalAlign=middle;strokeColor=none;fillColor=none;fontColor=#82b366;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="590" y="578" width="420" height="25" as="geometry"/>
        </mxCell>

        <!-- Background frames -->
        <mxCell id="bg_mt" value="Main Thread" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f9ff;strokeColor=#6c8ebf;strokeWidth=2;fontSize=18;fontStyle=1;fontFamily=Noto Sans JP;fontColor=#1a3a5c;align=center;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="50" y="110" width="540" height="520" as="geometry"/>
        </mxCell>
        <mxCell id="bg_w" value="Detection Worker" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff8e6;strokeColor=#d6b656;strokeWidth=2;fontSize=18;fontStyle=1;fontFamily=Noto Sans JP;fontColor=#7a5c00;align=center;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="1010" y="110" width="540" height="520" as="geometry"/>
        </mxCell>

        <!-- MT nodes -->
        <mxCell id="box_mt1" value="decode VideoFrame&lt;br&gt;owns GPU buffer" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=2;fontSize=17;fontFamily=Noto Sans JP;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="90" y="200" width="460" height="65" as="geometry"/>
        </mxCell>
        <mxCell id="note_mt" value="frame is neutered — cannot be used" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;strokeWidth=1;fontSize=15;fontFamily=Noto Sans JP;fontStyle=2;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="90" y="360" width="460" height="50" as="geometry"/>
        </mxCell>

        <!-- Worker nodes -->
        <mxCell id="box_w1" value="createImageBitmap()&lt;br&gt;GPU resize to 576×576" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=2;fontSize=17;fontFamily=Noto Sans JP;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="1050" y="400" width="460" height="65" as="geometry"/>
        </mxCell>
        <mxCell id="box_w2" value="ONNX inference on GPU" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;strokeWidth=2;fontSize=17;fontFamily=Noto Sans JP;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="1050" y="485" width="460" height="65" as="geometry"/>
        </mxCell>
        <mxCell id="note_w" value="worker calls frame.close()" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;strokeWidth=1;fontSize=15;fontFamily=Noto Sans JP;fontStyle=2;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="1050" y="560" width="460" height="45" as="geometry"/>
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
