<mxfile>
  <diagram name="worker-protocol">
    <mxGraphModel defaultFontFamily="Noto Sans JP" page="0" pageWidth="1700" pageHeight="880">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>

        <!-- Title -->
        <mxCell id="title" value="Worker Message Protocol" style="text;html=1;fontSize=28;fontStyle=1;fontFamily=Noto Sans JP;align=center;verticalAlign=middle;strokeColor=none;fillColor=none;" vertex="1" parent="1">
          <mxGeometry x="100" y="15" width="1500" height="45" as="geometry"/>
        </mxCell>
        <!-- Meta -->
        <mxCell id="meta" value="Typed message protocol between main thread and detection worker — id field matches responses to requests" style="text;html=1;fontSize=14;fontFamily=Noto Sans JP;align=center;verticalAlign=middle;strokeColor=none;fillColor=none;fontStyle=2;" vertex="1" parent="1">
          <mxGeometry x="100" y="58" width="1500" height="25" as="geometry"/>
        </mxCell>

        <!-- Background frames (drawn before arrows so arrows appear on top) -->
        <mxCell id="bg_mt" value="Main Thread" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f9ff;strokeColor=#6c8ebf;strokeWidth=2;fontSize=18;fontStyle=1;fontFamily=Noto Sans JP;fontColor=#1a3a5c;align=center;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="50" y="110" width="530" height="700" as="geometry"/>
        </mxCell>
        <mxCell id="bg_w" value="Detection Worker" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff8e6;strokeColor=#d6b656;strokeWidth=2;fontSize=18;fontStyle=1;fontFamily=Noto Sans JP;fontColor=#7a5c00;align=center;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="1120" y="110" width="530" height="700" as="geometry"/>
        </mxCell>

        <!-- Worker action boxes -->
        <mxCell id="w_load" value="load ONNX model&lt;br&gt;compile WGSL shaders" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=2;fontSize=17;fontFamily=Noto Sans JP;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="1160" y="245" width="450" height="55" as="geometry"/>
        </mxCell>
        <mxCell id="w_inference" value="resize frame → build tensor → run ONNX graph" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=2;fontSize=17;fontFamily=Noto Sans JP;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="1160" y="530" width="450" height="55" as="geometry"/>
        </mxCell>

        <!-- Arrows (back layer) — gap is x=580 to x=1120 (540px) -->
        <!-- Arrow row y positions: 205, 320, 370, 420, 475, 595, 650, 705 -->

        <!-- init MT→W: grey -->
        <mxCell id="arr_init" style="edgeStyle=none;rounded=0;html=1;strokeWidth=2;endArrow=block;endFill=1;strokeColor=#666666;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="580" y="205" as="sourcePoint"/>
            <mxPoint x="1120" y="205" as="targetPoint"/>
          </mxGeometry>
        </mxCell>
        <mxCell id="lbl_init" value="{type: 'init'}" style="text;html=1;fontSize=14;fontFamily=Noto Sans JP;align=center;verticalAlign=middle;strokeColor=none;fillColor=none;fontColor=#444444;" vertex="1" parent="1">
          <mxGeometry x="580" y="212" width="540" height="24" as="geometry"/>
        </mxCell>

        <!-- status1 W→MT: grey dashed -->
        <mxCell id="arr_status1" style="edgeStyle=none;rounded=0;html=1;strokeWidth=2;endArrow=block;endFill=1;strokeColor=#666666;dashed=1;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1120" y="323" as="sourcePoint"/>
            <mxPoint x="580" y="323" as="targetPoint"/>
          </mxGeometry>
        </mxCell>
        <mxCell id="lbl_status1" value="{type: 'status', message: 'Downloading…'}" style="text;html=1;fontSize=14;fontFamily=Noto Sans JP;align=center;verticalAlign=middle;strokeColor=none;fillColor=none;fontColor=#444444;" vertex="1" parent="1">
          <mxGeometry x="580" y="330" width="540" height="24" as="geometry"/>
        </mxCell>

        <!-- status2 W→MT: grey dashed -->
        <mxCell id="arr_status2" style="edgeStyle=none;rounded=0;html=1;strokeWidth=2;endArrow=block;endFill=1;strokeColor=#666666;dashed=1;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1120" y="373" as="sourcePoint"/>
            <mxPoint x="580" y="373" as="targetPoint"/>
          </mxGeometry>
        </mxCell>
        <mxCell id="lbl_status2" value="{type: 'status', message: 'Compiling shaders…'}" style="text;html=1;fontSize=14;fontFamily=Noto Sans JP;align=center;verticalAlign=middle;strokeColor=none;fillColor=none;fontColor=#444444;" vertex="1" parent="1">
          <mxGeometry x="580" y="380" width="540" height="24" as="geometry"/>
        </mxCell>

        <!-- ready W→MT: green -->
        <mxCell id="arr_ready" style="edgeStyle=none;rounded=0;html=1;strokeWidth=2;endArrow=block;endFill=1;strokeColor=#82b366;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1120" y="423" as="sourcePoint"/>
            <mxPoint x="580" y="423" as="targetPoint"/>
          </mxGeometry>
        </mxCell>
        <mxCell id="lbl_ready" value="{type: 'ready'}" style="text;html=1;fontSize=14;fontFamily=Noto Sans JP;align=center;verticalAlign=middle;strokeColor=none;fillColor=none;fontColor=#82b366;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="580" y="430" width="540" height="24" as="geometry"/>
        </mxCell>

        <!-- detect1 MT→W: blue -->
        <mxCell id="arr_detect1" style="edgeStyle=none;rounded=0;html=1;strokeWidth=2;endArrow=block;endFill=1;strokeColor=#6c8ebf;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="580" y="478" as="sourcePoint"/>
            <mxPoint x="1120" y="478" as="targetPoint"/>
          </mxGeometry>
        </mxCell>
        <mxCell id="lbl_detect1" value="{type: 'detect', id: 42, threshold: 0.5, frame}" style="text;html=1;fontSize=14;fontFamily=Noto Sans JP;align=center;verticalAlign=middle;strokeColor=none;fillColor=none;fontColor=#6c8ebf;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="580" y="485" width="540" height="24" as="geometry"/>
        </mxCell>

        <!-- detect-result W→MT: green -->
        <mxCell id="arr_result" style="edgeStyle=none;rounded=0;html=1;strokeWidth=2;endArrow=block;endFill=1;strokeColor=#82b366;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1120" y="600" as="sourcePoint"/>
            <mxPoint x="580" y="600" as="targetPoint"/>
          </mxGeometry>
        </mxCell>
        <mxCell id="lbl_result" value="{type: 'detect-result', id: 42, results: [...]}" style="text;html=1;fontSize=14;fontFamily=Noto Sans JP;align=center;verticalAlign=middle;strokeColor=none;fillColor=none;fontColor=#82b366;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="580" y="607" width="540" height="24" as="geometry"/>
        </mxCell>

        <!-- detect2 MT→W: blue -->
        <mxCell id="arr_detect2" style="edgeStyle=none;rounded=0;html=1;strokeWidth=2;endArrow=block;endFill=1;strokeColor=#6c8ebf;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="580" y="660" as="sourcePoint"/>
            <mxPoint x="1120" y="660" as="targetPoint"/>
          </mxGeometry>
        </mxCell>
        <mxCell id="lbl_detect2" value="{type: 'detect', id: 43, frame}" style="text;html=1;fontSize=14;fontFamily=Noto Sans JP;align=center;verticalAlign=middle;strokeColor=none;fillColor=none;fontColor=#6c8ebf;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="580" y="667" width="540" height="24" as="geometry"/>
        </mxCell>

        <!-- error W→MT: red -->
        <mxCell id="arr_error" style="edgeStyle=none;rounded=0;html=1;strokeWidth=2;endArrow=block;endFill=1;strokeColor=#b85450;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1120" y="718" as="sourcePoint"/>
            <mxPoint x="580" y="718" as="targetPoint"/>
          </mxGeometry>
        </mxCell>
        <mxCell id="lbl_error" value="{type: 'error', id: 43, error: '...'}" style="text;html=1;fontSize=14;fontFamily=Noto Sans JP;align=center;verticalAlign=middle;strokeColor=none;fillColor=none;fontColor=#b85450;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="580" y="725" width="540" height="24" as="geometry"/>
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
