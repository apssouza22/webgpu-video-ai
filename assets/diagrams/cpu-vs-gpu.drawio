<mxfile>
  <diagram name="cpu-vs-gpu">
    <mxGraphModel defaultFontFamily="Noto Sans JP" page="0" pageWidth="1200" pageHeight="540">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>

        <!-- Title -->
        <mxCell id="title" value="CPU vs GPU: Matrix Multiply Parallelism" style="text;html=1;fontSize=28;fontStyle=1;fontFamily=Noto Sans JP;align=center;verticalAlign=middle;strokeColor=none;fillColor=none;" vertex="1" parent="1">
          <mxGeometry x="100" y="15" width="1000" height="45" as="geometry"/>
        </mxCell>
        <!-- Meta -->
        <mxCell id="meta" value="Sequential CPU execution versus parallel GPU shader invocations" style="text;html=1;fontSize=14;fontFamily=Noto Sans JP;align=center;verticalAlign=middle;strokeColor=none;fillColor=none;fontStyle=2;" vertex="1" parent="1">
          <mxGeometry x="100" y="55" width="1000" height="25" as="geometry"/>
        </mxCell>

        <!-- CPU arrows (back layer) -->
        <mxCell id="arr_c0c1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeWidth=2;endArrow=block;endFill=1;strokeColor=#6c8ebf;fontFamily=Noto Sans JP;fontSize=14;" edge="1" source="c0" target="c1" parent="1">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="arr_c1c2" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeWidth=2;endArrow=block;endFill=1;strokeColor=#6c8ebf;fontFamily=Noto Sans JP;fontSize=14;" edge="1" source="c1" target="c2" parent="1">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="arr_c2cN" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeWidth=2;endArrow=block;endFill=1;strokeColor=#6c8ebf;fontFamily=Noto Sans JP;fontSize=14;" edge="1" source="c2" target="cN" parent="1">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <!-- Background frames -->
        <mxCell id="bg_cpu" value="CPU — Sequential  O(N³)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f9ff;strokeColor=#6c8ebf;strokeWidth=2;fontSize=18;fontStyle=1;fontFamily=Noto Sans JP;fontColor=#1a3a5c;align=center;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="50" y="100" width="490" height="380" as="geometry"/>
        </mxCell>
        <mxCell id="bg_gpu" value="GPU — Parallel  O(N) amortized" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f0fff0;strokeColor=#82b366;strokeWidth=2;fontSize=18;fontStyle=1;fontFamily=Noto Sans JP;fontColor=#1a5c1a;align=center;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="660" y="100" width="490" height="380" as="geometry"/>
        </mxCell>

        <!-- CPU nodes -->
        <mxCell id="c0" value="row 0: result += A[0][i] * B[i][col]" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=2;fontSize=17;fontFamily=Noto Sans JP;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="100" y="150" width="390" height="55" as="geometry"/>
        </mxCell>
        <mxCell id="c1" value="row 1: result += A[1][i] * B[i][col]" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=2;fontSize=17;fontFamily=Noto Sans JP;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="100" y="225" width="390" height="55" as="geometry"/>
        </mxCell>
        <mxCell id="c2" value="row 2: result += A[2][i] * B[i][col]" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=2;fontSize=17;fontFamily=Noto Sans JP;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="100" y="300" width="390" height="55" as="geometry"/>
        </mxCell>
        <mxCell id="cN" value="... row N" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=2;fontSize=17;fontFamily=Noto Sans JP;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="100" y="375" width="390" height="55" as="geometry"/>
        </mxCell>

        <!-- GPU nodes -->
        <mxCell id="g_note" value="All rows execute simultaneously:" style="text;html=1;fontSize=15;fontStyle=2;fontFamily=Noto Sans JP;strokeColor=none;fillColor=none;align=center;" vertex="1" parent="1">
          <mxGeometry x="680" y="148" width="440" height="35" as="geometry"/>
        </mxCell>
        <mxCell id="g0" value="core 0&lt;br&gt;row 0" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=2;fontSize=17;fontFamily=Noto Sans JP;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="680" y="195" width="200" height="55" as="geometry"/>
        </mxCell>
        <mxCell id="g1" value="core 1&lt;br&gt;row 1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=2;fontSize=17;fontFamily=Noto Sans JP;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="920" y="195" width="200" height="55" as="geometry"/>
        </mxCell>
        <mxCell id="g2" value="core 2&lt;br&gt;row 2" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=2;fontSize=17;fontFamily=Noto Sans JP;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="680" y="280" width="200" height="55" as="geometry"/>
        </mxCell>
        <mxCell id="gN" value="core N&lt;br&gt;row N" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=2;fontSize=17;fontFamily=Noto Sans JP;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="920" y="280" width="200" height="55" as="geometry"/>
        </mxCell>
        <mxCell id="g_result" value="O(N) amortized — hundreds of TFLOPS" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;strokeWidth=2;fontSize=17;fontFamily=Noto Sans JP;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="680" y="365" width="440" height="55" as="geometry"/>
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
