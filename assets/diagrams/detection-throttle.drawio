<mxfile>
  <diagram name="detection-throttle">
    <mxGraphModel defaultFontFamily="Noto Sans JP" page="0" pageWidth="1100" pageHeight="780">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>

        <!-- Title -->
        <mxCell id="title" value="Detection Throttle State Machine" style="text;html=1;fontSize=28;fontStyle=1;fontFamily=Noto Sans JP;align=center;verticalAlign=middle;strokeColor=none;fillColor=none;" vertex="1" parent="1">
          <mxGeometry x="100" y="15" width="900" height="45" as="geometry"/>
        </mxCell>
        <!-- Meta -->
        <mxCell id="meta" value="At most one inference in flight and one pending — detection rate auto-adapts to hardware" style="text;html=1;fontSize=14;fontFamily=Noto Sans JP;align=center;verticalAlign=middle;strokeColor=none;fillColor=none;fontStyle=2;" vertex="1" parent="1">
          <mxGeometry x="100" y="55" width="900" height="25" as="geometry"/>
        </mxCell>

        <!-- Arrows (back layer) -->
        <mxCell id="arr1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeWidth=2;endArrow=block;endFill=1;strokeColor=#666666;fontFamily=Noto Sans JP;fontSize=14;" edge="1" source="schedule" target="busy_check" parent="1">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="arr2" value="YES" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeWidth=2;endArrow=block;endFill=1;strokeColor=#666666;fontFamily=Noto Sans JP;fontSize=14;exitX=0;exitY=0.5;exitDx=0;exitDy=0;" edge="1" source="busy_check" target="store_pending" parent="1">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="arr3" value="NO" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeWidth=2;endArrow=block;endFill=1;strokeColor=#666666;fontFamily=Noto Sans JP;fontSize=14;exitX=1;exitY=0.5;exitDx=0;exitDy=0;" edge="1" source="busy_check" target="run_detection" parent="1">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="arr4" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeWidth=2;endArrow=block;endFill=1;strokeColor=#666666;fontFamily=Noto Sans JP;fontSize=14;" edge="1" source="run_detection" target="await_inf" parent="1">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="arr5" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeWidth=2;endArrow=block;endFill=1;strokeColor=#666666;fontFamily=Noto Sans JP;fontSize=14;" edge="1" source="await_inf" target="store_results" parent="1">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="arr6" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeWidth=2;endArrow=block;endFill=1;strokeColor=#666666;fontFamily=Noto Sans JP;fontSize=14;" edge="1" source="store_results" target="pending_check" parent="1">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="arr7" value="NO" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeWidth=2;endArrow=block;endFill=1;strokeColor=#666666;fontFamily=Noto Sans JP;fontSize=14;exitX=0;exitY=0.5;exitDx=0;exitDy=0;" edge="1" source="pending_check" target="idle" parent="1">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="arr8" value="YES" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeWidth=2;endArrow=block;endFill=1;strokeColor=#666666;fontFamily=Noto Sans JP;fontSize=14;" edge="1" source="pending_check" target="run_pending" parent="1">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <!-- Dashed arrow: store_pending to store_results -->
        <mxCell id="arr9" value="waits for current inference" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeWidth=2;endArrow=block;endFill=1;strokeColor=#666666;dashed=1;fontFamily=Noto Sans JP;fontSize=13;" edge="1" source="store_pending" target="store_results" parent="1">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="630" y="312"/>
              <mxPoint x="630" y="492"/>
            </Array>
          </mxGeometry>
        </mxCell>
        <!-- Loop arrow: run_pending back to await_inf -->
        <mxCell id="arr10" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeWidth=2;endArrow=block;endFill=1;strokeColor=#666666;fontFamily=Noto Sans JP;fontSize=14;" edge="1" source="run_pending" target="await_inf" parent="1">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="1070" y="677"/>
              <mxPoint x="1070" y="402"/>
            </Array>
          </mxGeometry>
        </mxCell>

        <!-- Nodes -->
        <mxCell id="schedule" value="schedule(videoFrame)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=2;fontSize=17;fontFamily=Noto Sans JP;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="400" y="80" width="280" height="55" as="geometry"/>
        </mxCell>
        <mxCell id="busy_check" value="detectionBusy?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=2;fontSize=17;fontFamily=Noto Sans JP;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="400" y="175" width="280" height="65" as="geometry"/>
        </mxCell>
        <mxCell id="store_pending" value="pendingFrame = frame&lt;br&gt;close previous pending if any" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=2;fontSize=17;fontFamily=Noto Sans JP;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="60" y="280" width="280" height="65" as="geometry"/>
        </mxCell>
        <mxCell id="run_detection" value="runDetection(frame)&lt;br&gt;detectionBusy = true" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=2;fontSize=17;fontFamily=Noto Sans JP;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="760" y="280" width="280" height="55" as="geometry"/>
        </mxCell>
        <mxCell id="await_inf" value="await ONNX inference" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=2;fontSize=17;fontFamily=Noto Sans JP;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="760" y="375" width="280" height="55" as="geometry"/>
        </mxCell>
        <mxCell id="store_results" value="store detections&lt;br&gt;detectionBusy = false" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=2;fontSize=17;fontFamily=Noto Sans JP;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="760" y="465" width="280" height="55" as="geometry"/>
        </mxCell>
        <mxCell id="pending_check" value="pendingFrame?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=2;fontSize=17;fontFamily=Noto Sans JP;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="760" y="555" width="280" height="65" as="geometry"/>
        </mxCell>
        <mxCell id="run_pending" value="runDetection(pendingFrame)&lt;br&gt;pendingFrame = null" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=2;fontSize=17;fontFamily=Noto Sans JP;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="760" y="650" width="280" height="55" as="geometry"/>
        </mxCell>
        <mxCell id="idle" value="idle" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;strokeWidth=2;fontSize=17;fontFamily=Noto Sans JP;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="370" y="650" width="230" height="55" as="geometry"/>
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
